# ==============================================================================
# Yorkstead Starter — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control. Only .env.example is tracked.
# ==============================================================================

# --- AI Provider ---
# Get your free API key from: https://aistudio.google.com/apikey
# The AI SDK reads this variable automatically — no extra wiring needed.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- App ---
# Display name used in the UI and metadata.
NEXT_PUBLIC_APP_NAME=Yorkstead App
